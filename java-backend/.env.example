# NCWU StyleHub Java backend — configuration reference
# Spring Boot reads OS environment variables (not .env files directly).
# Copy these values into your shell/session before running `mvn spring-boot:run`.

# Supabase Cloud PostgreSQL (Session pooler connection string).
# Leave empty to use the local H2 fallback database.
DATABASE_URL=

# Optional explicit credentials (embedded user:pass@host form of DATABASE_URL also works)
DATABASE_USER=
DATABASE_PASSWORD=

# JWT signing key - keep identical to the Python backend to share sessions
SECRET_KEY=ncwu-stylehub-dev-secret-change-in-production

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Listen port
SERVER_PORT=8080

# Disable demo customer password resets and sample data seeding in production.
APP_DEMO_ENABLED=false

# Separate restricted demo-admin login; it can only view products, reviews and aggregate stats.
# Disable it with APP_DEMO_ADMIN_ENABLED=false if the public demo login is not wanted.
APP_DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_EMAIL=demo-admin@shop.ncwu.site
DEMO_ADMIN_PASSWORD=demo-admin@123

# Cloudinary (optional) - admin product image uploads are stored on Cloudinary
# when these are set; otherwise they fall back to the local uploads/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ncwu-stylehub

# Resend email (optional locally); this inbox receives contact and refund alerts.
RESEND_API_KEY=
MAIL_FROM=NCWU StyleHub <info@shop.ncwu.site>
ADMIN_EMAIL=md.milton@qq.com
