# Copy to .env on EC2. Never commit .env.
# Supabase Connect > Session pooler (port 5432); use separate credentials.
DATABASE_URL=postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=postgres.PROJECT_REF
DATABASE_PASSWORD=
# Generate on EC2: openssl rand -hex 32
SECRET_KEY=
# Exact frontend origin; no trailing slash. Separate multiple origins with commas.
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
SITE_URL=https://YOUR-PROJECT.vercel.app

# Optional Cloudinary uploads; otherwise Docker volume stores uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ncwu-stylehub

# Optional transactional email
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=md.milton@qq.com
